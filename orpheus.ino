Adafruit_SH1106G display(128, 64, &Wire, -1, 400000, 100000);

void setup() {
  Serial.begin(115200);
  Wire.begin(8, 9);  // SDA = 8, SCL = 9
  if (!display.begin(0x3C, true)) {
    Serial.println("OLED not found");
    while (true) delay(100);
  }
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SH110X_WHITE);
  display.setCursor(22, 24);
  display.println("ORPHEUS");
  display.display();
  delay(5000);
  display.clearDisplay();
  display.display();
}

void drawFullFace(void) {
  display.clearDisplay();
  display.drawBitmap(44, 4, image_left_eye_bits, 14, 37, 1);
  display.drawBitmap(70, 4, image_right_eye_bits, 14, 37, 1);
  display.drawBitmap(47, 50, image_Mouth_bits, 34, 10, 1);
  display.display();
}

void drawBlink1(void) {
  display.clearDisplay();
  display.drawBitmap(44, 9, image_blink1_eye_bits, 14, 28, 1);
  display.drawBitmap(70, 9, image_blink1_eye_bits, 14, 28, 1);
  display.drawBitmap(47, 49, image_Mouth_bits, 34, 10, 1);
  display.display();
}

void drawBlink2(void) {
  display.clearDisplay();
  display.drawBitmap(44, 13, image_blink2_eye_bits, 14, 20, 1);
  display.drawBitmap(70, 13, image_blink2_eye_bits, 14, 20, 1);
  display.drawBitmap(47, 48, image_Mouth_bits, 34, 10, 1);
  display.display();
}

void drawBlink3(void) {
  display.clearDisplay();
  display.drawBitmap(44, 17, image_blink3_eye_bits, 14, 12, 1);
  display.drawBitmap(70, 17, image_blink3_eye_bits, 14, 12, 1);
  display.drawBitmap(47, 47, image_Mouth_bits, 34, 10, 1);
  display.display();
}

void drawBlink4(void) {
  display.clearDisplay();
  display.drawBitmap(44, 21, image_blink4_eye_bits, 14, 5, 1);
  display.drawBitmap(70, 21, image_blink4_eye_bits, 14, 5, 1);
  display.drawBitmap(47, 46, image_Mouth_bits, 34, 10, 1);
  display.display();
}

void loop() {
  drawFullFace();
  delay(5000);

  // closing
  drawBlink1();
  delay(20);
  drawBlink2();
  delay(20);
  drawBlink3();
  delay(20);
  drawBlink4();
  delay(80);   // hold the closed frame a touch longer

  // opening
  drawBlink3();
  delay(20);
  drawBlink2();
  delay(20);
  drawBlink1();
  delay(20);
}
